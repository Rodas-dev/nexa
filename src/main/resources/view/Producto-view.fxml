<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.juniorsdevelopers.nexa.factory.controller.ProductoController"
            style="-fx-background-color: #f4f7fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: #0b2341;">

            <padding>
                <Insets top="18" right="30" bottom="18" left="30"/>
            </padding>

            <Label text="NEXA"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <VBox spacing="2">

                <Label text="Gestión de Productos"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Label text="Administra los productos del sistema"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #b8c7dc;"/>

            </VBox>

        </HBox>
    </top>

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #dbe4f0;
                         -fx-border-radius: 10;
                         -fx-border-width: 1;">

                <padding>
                    <Insets top="20" right="25" bottom="20" left="25"/>
                </padding>

                <Label text="Datos del producto"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #12345b;"/>

                <GridPane hgap="15" vgap="12">

                    <Label text="Nombre:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del producto"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"
                               prefWidth="260"
                               style="-fx-background-color: #f8fafc;
                                      -fx-border-color: #cbd5e1;
                                      -fx-border-radius: 6;
                                      -fx-background-radius: 6;"/>

                    <Label text="Descripción:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <TextField fx:id="txtDescripcion"
                               promptText="Descripción"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"
                               prefWidth="260"
                               style="-fx-background-color: #f8fafc;
                                      -fx-border-color: #cbd5e1;
                                      -fx-border-radius: 6;
                                      -fx-background-radius: 6;"/>

                    <Label text="Stock:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <TextField fx:id="txtStock"
                               promptText="Cantidad"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"
                               prefWidth="260"
                               style="-fx-background-color: #f8fafc;
                                      -fx-border-color: #cbd5e1;
                                      -fx-border-radius: 6;
                                      -fx-background-radius: 6;"/>

                    <Label text="Estado:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #1f2937;"/>

                    <ComboBox fx:id="cmbEstado"
                              promptText="Seleccionar estado"
                              prefWidth="260"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="1"
                              style="-fx-background-color: #f8fafc;
                                     -fx-border-color: #cbd5e1;
                                     -fx-border-radius: 6;
                                     -fx-background-radius: 6;"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Registrar"
                            fx:id="btnRegistrar"
                            onAction="#registrarProducto"
                            prefWidth="110"
                            prefHeight="38"
                            style="-fx-background-color: #1769e8;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>

                    <Button text="Editar"
                            fx:id="btnEditar"
                            onAction="#editarProducto"
                            prefWidth="100"
                            prefHeight="38"
                            style="-fx-background-color: #f59e0b;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>

                    <Button text="Eliminar"
                            fx:id="btnEliminar"
                            onAction="#eliminarProducto"
                            prefWidth="105"
                            prefHeight="38"
                            style="-fx-background-color: #dc2626;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>

                    <Button text="Limpiar"
                            fx:id="btnLimpiar"
                            onAction="#limpiarCampos"
                            prefWidth="100"
                            prefHeight="38"
                            style="-fx-background-color: #64748b;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>

                </HBox>

            </VBox>

            <VBox spacing="12"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #dbe4f0;
                         -fx-border-radius: 10;">

                <padding>
                    <Insets top="20" right="25" bottom="20" left="25"/>
                </padding>

                <Label text="Productos registrados"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #12345b;"/>

                <TableView fx:id="tablaProductos"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white;
                                  -fx-border-color: #dbe4f0;
                                  -fx-border-radius: 6;">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="200"/>

                        <TableColumn fx:id="colDescripcion"
                                     text="Descripción"
                                     prefWidth="300"/>

                        <TableColumn fx:id="colStock"
                                     text="Stock"
                                     prefWidth="120"/>

                        <TableColumn fx:id="colEstado"
                                     text="Estado"
                                     prefWidth="180"/>

                    </columns>

                    <placeholder>
                        <Label text="No hay productos registrados"
                               style="-fx-text-fill: #64748b;
                                      -fx-font-size: 14px;"/>
                    </placeholder>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>