<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="620.0" prefWidth="960.0" styleClass="raiz" stylesheets="@../css/login-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juniorsdevelopers.nexa.factory.controller.LoginController">

    <StackPane prefWidth="440.0" styleClass="panel-izquierdo">
        <ImageView fitHeight="620.0" fitWidth="440.0" preserveRatio="false">
            <Image url="@../imagenes/fondo-factory.JPG" />
        </ImageView>
        <VBox styleClass="capa-oscura">
         <children>
              <VBox alignment="BOTTOM_LEFT" spacing="18.0" styleClass="contenido-izquierdo">
                  <padding>
                      <Insets bottom="40.0" left="45.0" right="45.0" top="40.0" />
                  </padding>
               <children>
                  <ImageView fitHeight="353.0" fitWidth="354.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagenes/Logo-nexa.png" />
                     </image>
                  </ImageView>
               </children>
              </VBox>
         </children></VBox>
    </StackPane>

    <VBox alignment="CENTER" prefWidth="520.0" spacing="20.0" styleClass="panel-derecho">
        <padding>
            <Insets bottom="40.0" left="70.0" right="70.0" top="40.0" />
        </padding>

        <VBox spacing="4.0">
            <Label styleClass="titulo-login" text="Iniciar Sesión" />
            <Label styleClass="subtitulo-login" text="Accede a tu cuenta para continuar" wrapText="true" />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="etiqueta-campo" text="Selecciona tu rol" />
            <ComboBox fx:id="comboRol" maxWidth="Infinity" promptText="-- Selecciona un rol --" styleClass="campo-combo" />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="etiqueta-campo" text="Usuario" />
            <TextField fx:id="campoUsuario" promptText="Ingresa tu nombre de usuario" styleClass="campo-texto" />
        </VBox>

        <VBox spacing="6.0">
            <Label styleClass="etiqueta-campo" text="Contraseña" />
            <StackPane>
                <PasswordField fx:id="campoContrasena" promptText="Ingresa tu contraseña" styleClass="campo-texto" />
                <TextField fx:id="campoContrasenaVisible" promptText="Ingresa tu contraseña" styleClass="campo-texto" />
                <HBox alignment="CENTER_RIGHT" pickOnBounds="false">
                    <ToggleButton fx:id="botonMostrarContrasena" onAction="#alternarVisibilidadContrasena" styleClass="boton-ojo" text="👁" />
                </HBox>
            </StackPane>
        </VBox>

        <Button fx:id="botonIniciarSesion" maxWidth="Infinity" onAction="#iniciarSesion" styleClass="boton-primario" text="Iniciar Sesión" />

        <HBox alignment="CENTER" spacing="4.0">
            <Label styleClass="texto-pie" text="¿No tienes una cuenta?" />
            <Hyperlink fx:id="enlaceRegistro" onAction="#irARegistro" styleClass="enlace" text="Regístrate aquí" />
        </HBox>
    </VBox>

</HBox>