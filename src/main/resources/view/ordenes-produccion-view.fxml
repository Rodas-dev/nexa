<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="524.0" prefWidth="849.0" spacing="16.0" stylesheets="/css/orden-produccion-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juniorsdevelopers.nexa.factory.controller.OrdenProduccionController">

    <padding>
        <Insets bottom="25.0" left="25.0" right="30.0" top="25.0" />
    </padding>

    <Label text="Gestión de Órdenes de Fabricación" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="campoIdProducto" promptText="ID Producto" prefWidth="100.0" />
        <TextField fx:id="campoIdUsuario" promptText="ID Usuario" prefWidth="100.0" />
        <TextField fx:id="campoCantidad" promptText="Cantidad" prefWidth="100.0" />
        <ComboBox fx:id="comboEstado" promptText="Estado" prefWidth="130.0" />
        <Button fx:id="botonGuardar" onAction="#guardar" text="Guardar" />
        <Button fx:id="botonEliminar" onAction="#eliminar" text="Eliminar" />
        <Button fx:id="botonLimpiar" onAction="#limpiar" text="Nuevo" />
    </HBox>

    <TableView fx:id="tablaOrdenes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaIdOrden" prefWidth="80.0" text="ID Orden" />
            <TableColumn fx:id="columnaProducto" prefWidth="100.0" text="ID Producto" />
            <TableColumn fx:id="columnaUsuario" prefWidth="100.0" text="ID Usuario" />
            <TableColumn fx:id="columnaCantidad" prefWidth="100.0" text="Cantidad" />
            <TableColumn fx:id="columnaFecha" prefWidth="120.0" text="Fecha Creación" />
            <TableColumn fx:id="columnaEstado" prefWidth="140.0" text="Estado" />
        </columns>
    </TableView>

</VBox>
