<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F4F7FB;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juniorsdevelopers.nexa.factory.controller.OrdenesSupervisorController">

    <top>
        <VBox spacing="5">

            <padding>
                <Insets bottom="15" left="30" right="30" top="25" />
            </padding>

            <Label style="-fx-text-fill: #102A43;                           -fx-font-size: 25px;                           -fx-font-weight: bold;" text="Órdenes de Producción" />

            <Label style="-fx-text-fill: #718096;                           -fx-font-size: 13px;" text="Consulta y seguimiento de las órdenes de producción" />

        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets bottom="30" left="30" right="30" top="10" />
            </padding>

            <HBox spacing="10">

                <Button onAction="#cargarTodas" style="-fx-background-color: #0B82E6;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 6;                                -fx-padding: 8 14;" text="Todas las órdenes" />

            </HBox>

            <TableView fx:id="tablaOrdenes" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colIdOrden" prefWidth="70" text="ID" />

                    <TableColumn fx:id="colProducto" prefWidth="220" text="Producto" />

                    <TableColumn fx:id="colCantidad" prefWidth="120" text="Cantidad" />

                    <TableColumn fx:id="colAvance" prefWidth="120" text="Avance" />

                    <TableColumn fx:id="colEstado" prefWidth="160" text="Estado" />

                    <TableColumn fx:id="colFecha" prefWidth="140" text="Fecha" />

                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

            </TableView>

            <Label fx:id="lblTotalOrdenes" style="-fx-text-fill: #64748B;                           -fx-font-size: 12px;" text="Órdenes encontradas: 0" />

        </VBox>
    </center>

</BorderPane>
