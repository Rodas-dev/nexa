<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.juniorsdevelopers.nexa.factory.controller.OrdenesSupervisorController"
            style="-fx-background-color: #F4F7FB;">

    <top>
        <VBox spacing="5">

            <padding>
                <Insets top="25"
                        right="30"
                        bottom="15"
                        left="30"/>
            </padding>

            <Label text="Órdenes de Producción"
                   style="-fx-text-fill: #102A43;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="Consulta y seguimiento de las órdenes de producción"
                   style="-fx-text-fill: #718096;
                          -fx-font-size: 13px;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <HBox spacing="10">

                <Button text="Todas las órdenes"
                        onAction="#cargarTodas"
                        style="-fx-background-color: #0B82E6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 8 14;"/>

                <Button text="Órdenes activas"
                        onAction="#cargarActivas"
                        style="-fx-background-color: #E8F1FA;
                               -fx-text-fill: #0B6FC4;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 8 14;"/>

            </HBox>

            <TableView fx:id="tablaOrdenes"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colIdOrden"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colProducto"
                                 text="Producto"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colCantidad"
                                 text="Cantidad"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colAvance"
                                 text="Avance"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="140"/>

                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

            </TableView>

            <Label fx:id="lblTotalOrdenes"
                   text="Órdenes encontradas: 0"
                   style="-fx-text-fill: #64748B;
                          -fx-font-size: 12px;"/>

        </VBox>
    </center>

</BorderPane>