<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.juniorsdevelopers.nexa.factory.controller.AvancesSupervisorController"
            style="-fx-background-color: #F4F7FB;">

    <top>
        <VBox spacing="5">

            <padding>
                <Insets top="25"
                        right="30"
                        bottom="15"
                        left="30"/>
            </padding>

            <Label text="Registro de Avances"
                   style="-fx-text-fill: #102A43;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="Consulta y registro de la producción realizada"
                   style="-fx-text-fill: #718096;
                          -fx-font-size: 13px;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="10"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

           

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-padding: 18;">

                <Label text="Registrar nuevo avance"
                       style="-fx-text-fill: #172033;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;"/>

                <GridPane hgap="15"
                          vgap="10">

                    <Label text="ID de orden:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <TextField fx:id="txtIdOrden"
                               promptText="Ej. 1"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"
                               prefWidth="150"/>

                    <Label text="ID de usuario:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <TextField fx:id="txtIdUsuario"
                               promptText="Ej. 2"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0"
                               prefWidth="150"/>

                    <Label text="Cantidad:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 12px;"/>

                    <TextField fx:id="txtCantidad"
                               promptText="Cantidad producida"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"
                               prefWidth="150"/>

                    <Button text="Registrar avance"
                            onAction="#registrarAvance"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"
                            style="-fx-background-color: #0B82E6;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 8 14;"/>

                </GridPane>

                <Label fx:id="lblMensaje"
                       text=""
                       style="-fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

            </VBox>

        

            <HBox spacing="10">

                <Button text="Todos los avances"
                        onAction="#cargarTodos"
                        style="-fx-background-color: #0B82E6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 8 14;"/>

                <Button text="Producción de hoy"
                        onAction="#cargarHoy"
                        style="-fx-background-color: #E8F1FA;
                               -fx-text-fill: #0B6FC4;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 8 14;"/>

            </HBox>

         

            <TableView fx:id="tablaAvances"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colIdAvance"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colIdOrden"
                                 text="Orden"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colUsuario"
                                 text="Usuario"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colCantidad"
                                 text="Cantidad producida"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="140"/>

                </columns>

            </TableView>

            <Label fx:id="lblTotalAvances"
                   text="Avances encontrados: 0"
                   style="-fx-text-fill: #64748B;
                          -fx-font-size: 12px;"/>

        </VBox>
    </center>

</BorderPane>