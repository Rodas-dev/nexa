<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.juniorsdevelopers.nexa.factory.controller.ProcesosSupervisorController"
            style="-fx-background-color: #F4F7FB;">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="25" right="30" bottom="15" left="30"/>
            </padding>

            <Label text="Procesos de Producción"
                   style="-fx-text-fill: #102A43; -fx-font-size: 25px; -fx-font-weight: bold;"/>

            <Label text="Consulta y seguimiento de los procesos de las órdenes de producción"
                   style="-fx-text-fill: #718096; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="30" bottom="30" left="30"/>
            </padding>

            <HBox spacing="10">

                <Button text="Todos los procesos"
                        onAction="#cargarTodos"
                        style="-fx-background-color: #0B82E6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 14;"/>

                <Button text="Procesos activos"
                        onAction="#cargarActivos"
                        style="-fx-background-color: #E8F1FA; -fx-text-fill: #0B6FC4; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 14;"/>

            </HBox>

            <TableView fx:id="tablaProcesos"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colIdProceso"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colIdOrden"
                                 text="Orden"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colNombreProceso"
                                 text="Proceso"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colEstadoProceso"
                                 text="Estado"
                                 prefWidth="160"/>

                    <TableColumn fx:id="colSecuencia"
                                 text="Secuencia"
                                 prefWidth="100"/>

                </columns>

            </TableView>

            <Label fx:id="lblTotalProcesos"
                   text="Procesos encontrados: 0"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

        </VBox>
    </center>

</BorderPane>