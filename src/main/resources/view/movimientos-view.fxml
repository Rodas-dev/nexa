<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juniorsdevelopers.nexa.factory.controller.MovimientosController">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Registro de Movimientos" textFill="#003366">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Label layoutX="30.0" layoutY="60.0" text="Historial de entradas y salidas del almacén" textFill="#666666" />
        
        <TableView fx:id="tablaMovimientos" layoutX="30.0" layoutY="100.0" prefHeight="450.0" prefWidth="740.0" stylesheets="@../css/styles.css">
          <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colProducto" prefWidth="250.0" text="Producto / Materia Prima" />
            <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
            <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
            <TableColumn fx:id="colUsuario" prefWidth="115.0" text="Usuario" />
          </columns>
        </TableView>
    </children>
</AnchorPane>

