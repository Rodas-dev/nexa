<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="524.0" prefWidth="849.0" spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juniorsdevelopers.nexa.factory.controller.MateriaPrimaController">

    <padding>
        <Insets bottom="25.0" left="25.0" right="30.0" top="25.0" />
    </padding>

    <Label text="Materia Prima" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="campoNombre" promptText="Nombre" HBox.hgrow="ALWAYS" />
        <TextField fx:id="campoStock" promptText="Stock" />
        <ComboBox fx:id="comboUnidad" promptText="Unidad" />
        <Button fx:id="botonGuardar" onAction="#guardar" text="Guardar" />
        <Button fx:id="botonEliminar" onAction="#eliminar" text="Eliminar" />
        <Button fx:id="botonLimpiar" onAction="#limpiar" text="Nuevo" />
    </HBox>

    <TableView fx:id="tablaMateriaPrima" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="columnaStock" prefWidth="100.0" text="Stock" />
            <TableColumn fx:id="columnaUnidad" prefWidth="100.0" text="Unidad" />
            <TableColumn fx:id="columnaEstado" prefWidth="120.0" text="Estado" />
        </columns>
    </TableView>

</VBox>
